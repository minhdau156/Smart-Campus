<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Gets versions and build rules from the root pom.xml. -->
    <parent>
        <groupId>edu.campus</groupId>
        <artifactId>smart-campus</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!--
        Shared kernel: plain Java types used by every app (ids, Money, time, events, errors).
        No Spring code here: it must stay a small, framework-free library.
    -->
    <artifactId>shared-kernel</artifactId>
    <packaging>jar</packaging>
    <name>Smart Campus :: Shared Kernel</name>

    <build>
        <plugins>
            <!-- Guard (T4.1): the build fails if any Spring library ends up on the classpath,
                 directly or pulled in by another library. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>no-spring-in-shared-kernel</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework*</exclude>
                                    </excludes>
                                    <message>shared-kernel must stay framework-free: no Spring dependencies (spec, T4.1).</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Test-jar (T4.4): shares the test helpers in edu.campus.kernel.testing (e.g. Clocks)
                 with other modules' tests. Only that package goes in, not our own tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-helpers-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>edu/campus/kernel/testing/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Coverage gate (T4.6): the build fails if the tests run less than 90% of the lines.
                 Adds a `check` step to the JaCoCo setup inherited from the root pom. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>coverage-gate</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
