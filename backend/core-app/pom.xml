<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Gets versions and build rules from the root pom.xml. -->
    <parent>
        <groupId>edu.campus</groupId>
        <artifactId>smart-campus</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!--
        core-app: the modular monolith (Spring Modulith). Each top-level package under edu.campus
        is one module (platform first; course, grade, ... later). Runs on port 8081.
    -->
    <artifactId>core-app</artifactId>
    <packaging>jar</packaging>
    <name>Smart Campus :: Core App</name>

    <dependencies>
        <!-- Our own plain-Java types (ids, Money, DomainEvent, Topics, ...). -->
        <dependency>
            <groupId>edu.campus</groupId>
            <artifactId>shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Shared Spring setup for all apps: problem JSON + traceId, outbox defaults and retry job,
             the Modulith module-detection rule. Switches itself on (auto-configuration). -->
        <dependency>
            <groupId>edu.campus</groupId>
            <artifactId>platform-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- REST endpoints (Spring MVC + embedded Tomcat). Boot 4 name for the old "starter-web". -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- API docs: /v3/api-docs (OpenAPI JSON) and /swagger-ui.html (version in the root pom). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- /actuator/health and metrics. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- DataSource (connection pool) + JdbcTemplate. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Database migrations. In Boot 4, Flyway support needs its own starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway's PostgreSQL support (a separate jar since Flyway 10). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- PostgreSQL JDBC driver: only needed when the app runs, not to compile. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Spring Modulith: module model (@ApplicationModule) and its runtime support. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <!-- Modulith's module model (ApplicationModules), needed at compile time by
             ModuleApiGroups (the starter above only puts it on the runtime classpath). -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-core</artifactId>
        </dependency>

        <!-- ===== Outbox (spec D1) ===== -->
        <!-- Event Publication Registry stored in PostgreSQL: every published event is saved in the
             table platform.event_publication, in the same transaction as the business data. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jdbc</artifactId>
        </dependency>
        <!-- Sends the saved events to Kafka after the commit ("externalization"). -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-kafka</artifactId>
        </dependency>
        <!-- Kafka client + KafkaTemplate + auto-configuration (spring.kafka.* settings). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- ===== Tests only ===== -->
        <!-- JUnit, AssertJ, Mockito, Spring test support. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WebMvcTest: test one controller without starting the whole app. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ApplicationModules.verify() and module tests. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Our own architecture rules (version pinned in the root pom). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: a real PostgreSQL in Docker for the *IT tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A real Kafka broker in Docker for the outbox tests (OutboxIT). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Waits until something becomes true ("await until 1 record arrived"). -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Builds the runnable jar and gives `spring-boot:run`.
                 `spring-boot:run` uses the `dev` profile (local Docker Compose infra). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <profiles>
                        <profile>dev</profile>
                    </profiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
