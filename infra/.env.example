# Local development settings for infra/docker-compose.yml.
# Copy this file to infra/.env (gitignored), then: docker compose -f infra/docker-compose.yml up -d --wait
# DEV ONLY: these passwords are for your own computer. Never reuse them anywhere else.

# --- Postgres (database "campus") ---
POSTGRES_DB=campus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev
# Per-service database users (created by infra/postgres/init/01-schemas-and-users.sh)
CORE_APP_DB_PASSWORD=core-app-dev
REGISTRATION_SVC_DB_PASSWORD=registration-svc-dev
NOTIFICATION_SVC_DB_PASSWORD=notification-svc-dev
KEYCLOAK_DB_PASSWORD=keycloak-dev

# --- Keycloak admin (http://localhost:8180) ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev

# --- RustFS, S3-compatible file store (API http://localhost:9000, console http://localhost:9001) ---
RUSTFS_ACCESS_KEY=campus-dev
RUSTFS_SECRET_KEY=campus-dev-secret
